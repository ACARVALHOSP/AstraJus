# Importar dentro do site 191-252-110-22.sslip.io, antes do proxy existente.
redir /novo /novo/ 308

handle_path /novo/assets/* {
    root * /srv/astrajus-frontend/assets
    header Cache-Control "public, max-age=31536000, immutable"
    file_server
}

handle_path /novo/* {
    root * /srv/astrajus-frontend/current
    header Cache-Control "no-cache"
    try_files {path} /index.html
    file_server
}
